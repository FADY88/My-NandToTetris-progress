/**
 * Implements the tic tac toe game.
 * In this game 2 players can play tic tac toe  
 * The game keep track of players' scores
 * In the beginning, it's X turn
 * Number pad keys are used to place X or O on board
 * The 'q' key is used to quit the game.
 */
class Game_Board {
    // some fields
    field int x, y, currentPlayer, location;
    field Array board;
    field boolean exit;

    
    constructor Game_Board new() {
        let x = 0;
        let y = 0;
        let currentPlayer = 0;
        let location = 0;
        let exit = false;
        let board = Array.new(9);
        do Game_Board.initialize();
        return this;
    }
    
    method void run() {
        var char key;
        var int winner;
        while (~exit) {
            do clearBoard();
            let winner = round();
            do Sys.wait(10000);
            do incScore(winner);
        }
        return;
    }

    method int round() {
        // logic of a complete round of the game, returns the winner (0 for X, 1 for O)
        var int winner;
        var int counter;
        let counter = 9;
        let winner = 2;
        // bug: user still can edit a place they already placed X or O in it
        while (winner = 2 & (~(counter = 0))) { 
            // test
            // do Output.moveCursor(17, 11);
            // do Output.printInt(board[0]);
            // do Output.printInt(board[1]);
            // do Output.printInt(board[2]);
            // do Output.moveCursor(18, 11);
            // do Output.printInt(board[3]);
            // do Output.printInt(board[4]);
            // do Output.printInt(board[5]);
            // do Output.moveCursor(19, 11);
            // do Output.printInt(board[6]);
            // do Output.printInt(board[7]);
            // do Output.printInt(board[8]);
            // test
            do input();
            do nextPlayer(); // increment currentPlayer and change its image
            let winner = whoWins();
            let counter = counter - 1;
        }
        return winner;
    }

    method void nextPlayer() {
        if (exit) { return; }

        if (currentPlayer = 0) {
            let currentPlayer = 1;
            do Game_Board.blanc(4262);
            do Game_Board.drawO(4262);
            do Game_Board.drawX(location);
            return;
        }
        else {
            let currentPlayer = 0;
            do Game_Board.blanc(4262);
            do Game_Board.drawX(4262);
            do Game_Board.drawO(location);
            return;
        }
    }

    method void input() {
        // takes user input and updates board array
        var int key; 
        while (key = 0) {
            let key = Keyboard.keyPressed();
        }

        if (key = 49) {let board[0] = currentPlayer; let location = 5172;}
        if (key = 50) {let board[1] = currentPlayer; let location = 5175;}
        if (key = 51) {let board[2] = currentPlayer; let location = 5178;}
        if (key = 52) {let board[3] = currentPlayer; let location = 3636;}
        if (key = 53) {let board[4] = currentPlayer; let location = 3639;}
        if (key = 54) {let board[5] = currentPlayer; let location = 3642;}
        if (key = 55) {let board[6] = currentPlayer; let location = 2068;}
        if (key = 56) {let board[7] = currentPlayer; let location = 2071;}
        if (key = 57) {let board[8] = currentPlayer; let location = 2074;}
        if (key = 113) {let exit = true;}
            
        while (~(key = 0)) {
            let key = Keyboard.keyPressed();
        }
        
        return;
    }

    method void clearBoard() {
        let currentPlayer = 0;
        do Game_Board.drawX(4262);
        
        let board[0] = 2;
        let board[1] = 3;
        let board[2] = 4;
        let board[3] = 5;
        let board[4] = 6;
        let board[5] = 7;
        let board[6] = 8;
        let board[7] = 9;
        let board[8] = 2;

        do Game_Board.blanc(2071);
        do Game_Board.blanc(2074);
        do Game_Board.blanc(2077);
        do Game_Board.blanc(3639);
        do Game_Board.blanc(3642);
        do Game_Board.blanc(3645);
        do Game_Board.blanc(5175);
        do Game_Board.blanc(5178);
        do Game_Board.blanc(5181);
        return;
    }

    method int whoWins() {
        var int winner;
        // (0 for X, 1 for O)
        if ((board[0] = board[1]) & (board[1] = board[2])) { return board[0]; }
        if ((board[3] = board[4]) & (board[4] = board[5])) { return board[3]; }
        if ((board[6] = board[7]) & (board[7] = board[8])) { return board[6]; }
        if ((board[0] = board[3]) & (board[3] = board[6])) { return board[0]; }
        if ((board[1] = board[4]) & (board[4] = board[7])) { return board[1]; }
        if ((board[2] = board[5]) & (board[5] = board[8])) { return board[2]; }
        if ((board[0] = board[4]) & (board[4] = board[8])) { return board[0]; }
        if ((board[2] = board[4]) & (board[4] = board[6])) { return board[2]; }
        if (exit)                                          { return 3; } // exit
        else                                               { return 2; } // no winner yet
        
    }

    method void incScore(int player) {
        if (player = 0) {
            let x = x + 1; // move this inside function call
            do Game_Board.setScore(0, x);
        }
        if (player = 1) {
            let y = y + 1;
            do Game_Board.setScore(1, y);
        }
        return;
    }

    function void setScore(int player, int score) {
        // sets the score of the player (0 for X, 1 for O)
        if (player = 0) {
            // let x = score; // error
            do Output.moveCursor(4, 6);
            do Output.printInt(score);
        }
        if (player = 1) {
            // let y = score;
            do Output.moveCursor(5, 6);
            do Output.printInt(score);
        }
        return;
    }
    
    method void dispose() {
        do board.dispose();
        do Memory.deAlloc(this);
        return;
    }

    function void initialize() {
        // game interface
        do Output.println();
        do Output.printString("         Tic-Tac-Toe");
        do Output.moveCursor(4, 2);
        do Output.printString("X =");
        do Output.moveCursor(5, 2);
        do Output.printString("O =");
        do Output.moveCursor(10, 0);
        do Output.printString("         Now Playing");
        do Game_Board.setScore(0, 0);
        do Game_Board.setScore(1, 0);
        do Screen.setColor(true);
        do Screen.drawRectangle(241, 0, 256, 256);
        do Screen.drawRectangle(86, 124, 138, 176);
        do Screen.setColor(false);
        do Screen.drawRectangle(88, 126, 136, 174);
        do Screen.setColor(true);
        do Output.moveCursor(17, 1);
        do Output.printString("Q = Exit");
        // board
        do Screen.drawRectangle(359, 48, 361, 208);
        do Screen.drawRectangle(407, 48, 409, 208);
        
        do Screen.drawRectangle(304, 103, 464, 105);
        do Screen.drawRectangle(304, 151, 464, 153);
        
        do Output.moveCursor(3, 42);
        do Output.printString("7     8     9");

        do Output.moveCursor(19, 42);
        do Output.printString("1     2     3");

        do Output.moveCursor(11, 35);
        do Output.printString("4");

        do Output.moveCursor(11, 60);
        do Output.printString("6");

        return;
    }

    function void drawO(int location) {
        var int memAddress; 
	    let memAddress = 16384+location;
        
        do Memory.poke(memAddress, -1024);
        do Memory.poke(memAddress +32, -512);
