        do Memory.poke(memAddress +737, 7936);
        do Memory.poke(memAddress +769, 3968);
        do Memory.poke(memAddress +801, 1984);
        do Memory.poke(memAddress +833, 992);
        do Memory.poke(memAddress +865, 511);
        do Memory.poke(memAddress +897, 255);
        do Memory.poke(memAddress +929, 127);
        do Memory.poke(memAddress +961, 63);
        do Memory.poke(memAddress +993, 31);
        return;
    }

