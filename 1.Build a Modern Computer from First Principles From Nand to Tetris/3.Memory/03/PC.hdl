// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Mux16(a = f1, b = in, sel = load, out = f2);
    Register(in = l, load = true, out = tmp, out = out);
    Inc16(in = tmp, out = tmp1);
    Mux16(a = tmp, b = tmp1, sel = inc, out = f1);
    Mux16(a = f2, b = false, sel = reset, out = l);
}