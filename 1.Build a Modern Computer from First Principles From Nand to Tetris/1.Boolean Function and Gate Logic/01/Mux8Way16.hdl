// File name: projects/1/Mux8Way16.hdl
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    // start (r = round)
    Mux16(a = a, b = b, sel = sel[0], out = r11);
    Mux16(a = c, b = d, sel = sel[0], out = r12);
    Mux16(a = e, b = f, sel = sel[0], out = r13);
    Mux16(a = g, b = h, sel = sel[0], out = r14);
    // semi final
    Mux16(a = r11, b = r12, sel = sel[1], out = r21);
    Mux16(a = r13, b = r14, sel = sel[1], out = r22);
    // final
    Mux16(a = r21, b = r22, sel = sel[2], out = out);
}